# Copy this file to .env and fill it in. .env is git-ignored - never commit it.

# Portal page that lists the reports (ask the team for the real URL)
PORTAL_URL=https://<portal-host>/ReportPortal/frmreport.aspx?reportid=141

# windows = log in as your Windows user (needs to run on a company Windows PC)
# none    = no login
AUTH_MODE=windows

# CSS selector for the download links on the portal page
LINK_SELECTOR=a[href*=frmofferfile]

# Folder for downloaded reports (relative to the project folder, or an absolute path)
DOWNLOAD_DIR=report

# Folder for the CSV files for ADX (default: your Downloads folder)
# OUTPUT_DIR=

# Recipient of the automatic mail (MAIL_CC is optional)
MAIL_TO=name.surname@company.mk
MAIL_CC=

# Minutes between checks, only used with --loop
CHECK_INTERVAL_MIN=60