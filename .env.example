# Copy this file to .env and fill it in. .env is git-ignored - never commit it.

# Portal page that lists the reports (ask the team for the real URL)
PORTAL_URL=https://<portal-host>/ReportPortal/frmreport.aspx?reportid=141

# windows = log in as your Windows user (needs to run on a company Windows PC)
# none    = no login
AUTH_MODE=windows

# CSS selector for the download links on the portal page
LINK_SELECTOR=a[href*=frmofferfile]

# Folder for the reports downloaded from the portal (relative to the project folder, or an absolute path)
DOWNLOAD_DIR=report

# Where the CSV files for ADX and Business_korisnici.xlsx are saved (default: your Downloads folder).
# To save them on the share, set it to M:\CustomerFinance\Collection_automation_reports\Next_day_collection_activities
# OUTPUT_DIR=

# Share folder where BI can put the report by hand (maz_ben_open_invoices_New_<date>); only read, after ALARM_TIME
SHARE_DIR=M:\CustomerFinance\Collection_automation_reports\Next_day_collection_activities

# If today's report is not found by this time, the alarm mail is sent (once per day)
ALARM_TIME=13:30

# Recipients (separate several addresses with ;)
# Alarm: "ALARM: Nepostaven ben_open file"
MAIL_ALARM_TO=CollectionVip@A1.mk
# Mail 1: "Collection activities dd.mm.yyyy pre-final" (numbers before the postponement)
MAIL_PRE_FINAL_TO=CollectionVip@A1.mk
# Mail 2: "Collection activities dd.mm.yyyy" (numbers after the postponement)
MAIL_FINAL_TO=Borce.Gorgieski@A1.mk
MAIL_FINAL_CC=CCTeamleaders@A1.mk; Business.ContactCenter@A1.mk; CollectionVip@A1.mk
# Mail 3: "Sledni bulk-ovi na suspenzii ..." (only when there are more than 2500 suspension MSISDNs)
MAIL_BULK_TO=BSSOperations@A1.mk; NOCmkd@A1.mk
MAIL_BULK_CC=CollectionVip@A1.mk; business.administration@A1.mk
